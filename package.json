{
  "name": "co-mmo",
  "private": true,
  "version": "0.1.0",
  "description": "A browser MMORPG built by its players through wishes to a God.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "concurrently -n server,client -c blue,green \"npm run dev -w @co-mmo/server\" \"npm run dev -w @co-mmo/client\"",
    "build": "npm run build -w @co-mmo/client",
    "start": "npm run start -w @co-mmo/server",
    "test": "vitest run",
    "playtest": "vitest run -c vitest.playtest.config.ts",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client",
    "anchors": "npm run anchors -w @co-mmo/server --",
    "game-art": "npm run game-art -w @co-mmo/server",
    "building-art": "npm run building-art -w @co-mmo/server --",
    "region-server": "npm run region-server -w @co-mmo/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "playwright": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
